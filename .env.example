MODEL_API_KEY=your_key_here

# Storage: filesystem (default) or mongodb. See docs/mongo.md.
# STORAGE_BACKEND=filesystem
# MONGO_DATABASE=tracker

# MongoDB connection: full URL override, or Atlas parts (recommended for
# Atlas — the URL is built as mongodb+srv://...?authSource=admin...).
# MONGO_URL=mongodb://localhost:27017/
# MONGODB_USER=
# MONGODB_PASSWORD=
# MONGODB_HOST=<cluster>.abc123.mongodb.net
